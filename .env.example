# ─── Database (Supabase) ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ─── Auth ─────────────────────────────────────────────────────────────────────
AUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="https://your-vercel-app.vercel.app"

# ─── Socket Server ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SOCKET_URL="https://your-socket-server.onrender.com"
SOCKET_SECRET="your-socket-jwt-secret"

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_live_..."
RAZORPAY_KEY_SECRET="your-razorpay-secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_..."

# ─── Telegram Bot (astrologer chat request notifications) ────────────────────
# 1. Open Telegram → message @BotFather → /newbot → follow prompts
# 2. BotFather gives you a token like: 123456789:ABCdef...
# 3. Paste it below
# 4. After deploying, register the webhook once by visiting:
#    https://api.telegram.org/bot<YOUR_TOKEN>/setWebhook?url=https://astrowalla.com/api/telegram/webhook
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"
