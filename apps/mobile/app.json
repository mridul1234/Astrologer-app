{
  "expo": {
    "name": "AstroWalla",
    "slug": "astrowalla",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "astrowalla",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.astrowalla.app",
      "versionCode": 1,
      "newArchEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#FFF9EF"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AstroWalla to let you share images in chat."
        }
      ]
    ]
  }
}
